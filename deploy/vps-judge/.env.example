# Copy to deploy/vps-judge/.env on the host. NEVER commit the real file.

# Shared secret the frontend sends as `x-lab-key` (also accepted as
# `x-judge-api-key`). Unset = the judge endpoint is OPEN (no auth) — set this
# in production.
LAB_API_KEY=

# Judge LLM provider. Defaults to "inference" (Algolia's inference server,
# OpenAI-compatible). Set to "openai" to use OPENAI_API_KEY instead.
JUDGE_PROVIDER=inference

# Auth for the inference server: a Vault-minted OIDC JWT. Expires roughly every
# 30 days — re-mint and refresh it on rotation, or every judge call returns 401.
ALGOLIA_INFERENCE_API_KEY=
# Override the inference endpoint. Optional; the code carries a default.
ALGOLIA_INFERENCE_BASE_URL=

# Only needed when JUDGE_PROVIDER=openai.
OPENAI_API_KEY=

# Model override. Defaults to "medium" on inference, "gpt-5" on openai.
JUDGE_MODEL=

# Per-IP rate limit on POST /api/* (judge calls spend LLM tokens = money).
# <=0 disables it.
RATE_LIMIT=30
RATE_WINDOW_MS=60000

PORT=8788
