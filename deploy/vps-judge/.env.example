# Copy to deploy/vps-judge/.env on the VPS. NEVER commit the real file.

# Shared secret the ACS frontend sends as `x-lab-key`. Unset = judge endpoint
# is OPEN (no auth) — set this in prod.
LAB_API_KEY=

# Judge LLM provider. Default GEMINI; set to "openai" to use OPENAI_API_KEY
# instead of GOOGLE_API_KEY.
JUDGE_PROVIDER=gemini
GOOGLE_API_KEY=
OPENAI_API_KEY=

# Per-IP rate limit on POST /api/* (judge calls spend LLM tokens = money).
# <=0 disables it.
RATE_LIMIT=30
RATE_WINDOW_MS=60000

PORT=8788
