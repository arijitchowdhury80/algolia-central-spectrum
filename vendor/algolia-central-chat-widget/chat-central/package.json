{
  "name": "@algolia-central/chat-central",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Chat Central — a custom InstantSearch.js widget (connector + UI-agnostic React renderer) for an Agent-Studio-backed chat experience. Built with the official 'Create your own widgets' pattern.",
  "files": [
    "dist",
    "src"
  ],
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./dist/*": "./dist/*"
  },
  "scripts": {
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "peerDependencies": {
    "instantsearch.js": "^4.106.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.1.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "autoprefixer": "^10.4.20",
    "globals": "^17.7.0",
    "instantsearch.js": "^4.106.0",
    "postcss": "^8.4.47",
    "prettier": "^3.9.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.13",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.0.0"
  }
}
