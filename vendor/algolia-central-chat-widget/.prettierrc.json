{
  "singleQuote": true,
  "semi": true,
  "trailingComma": "all",
  "printWidth": 100,
  "tabWidth": 2,
  "arrowParens": "always",
  "endOfLine": "lf",
  "overrides": [
    {
      "files": ["*.md", "*.html"],
      "options": { "printWidth": 100, "proseWrap": "preserve" }
    },
    {
      "files": "*.json",
      "options": { "singleQuote": false }
    }
  ]
}
