{
  "name": "algolia-central-website",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Demo website that embeds the compiled <algolia-central-chat> widget.",
  "scripts": {
    "sync:widget": "node scripts/sync-widget.mjs",
    "predev": "npm run sync:widget",
    "prebuild": "npm run sync:widget",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@algolia-central/chat-widget": "file:../algolia-chat"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "eslint": "^9.39.5",
    "prettier": "^3.9.5",
    "typescript": "~5.6.3",
    "vite": "^7.0.0"
  }
}
