{
  "name": "@algolia-central/chat-widget",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Embeddable <algolia-chat> web component: Algolia's native Chat widget + a grounding-confidence judge, wrapped in a self-contained Shadow-DOM custom element.",
  "files": [
    "dist"
  ],
  "exports": {
    "./dist/*": "./dist/*"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --config vite.confidence-badge.config.ts && vite build --config vite.brand.config.ts",
    "build:widget": "vite build",
    "build:badge": "vite build --config vite.confidence-badge.config.ts",
    "build:brand": "vite build --config vite.brand.config.ts",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,json,md,html}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@algolia-central/chat-central": "file:../chat-central",
    "algoliasearch": "^5.55.2",
    "instantsearch.js": "^4.106.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.1.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.1.0",
    "postcss": "^8.4.47",
    "prettier": "^3.9.5",
    "tailwindcss": "^3.4.13",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.0.0"
  }
}
